# Supabase browser-safe project values. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Add only in local ignored env files and Vercel Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Demo user credentials (dev project only — never real guests) ───
# These are set by scripts/seed-demo-users.sh. Use them to sign in as each role.
DEMO_GUEST_EMAIL=guest.demo@example.test
DEMO_GUEST_PASSWORD=DemoGuest123!
DEMO_RESIDENT_EMAIL=resident.demo@example.test
DEMO_RESIDENT_PASSWORD=DemoResident123!
DEMO_WORKER_EMAIL=worker.demo@example.test
DEMO_WORKER_PASSWORD=DemoWorker123!
DEMO_MANAGER_EMAIL=manager.demo@example.test
DEMO_MANAGER_PASSWORD=DemoManager123!
DEMO_ADMIN_EMAIL=admin.demo@example.test
DEMO_ADMIN_PASSWORD=DemoAdmin123!
